{
  "info": {
    "name": "02 - Tasks",
    "description": "Task management endpoints for the project/workstream task contract, including my-tasks filtering and CRUD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.data && response.data.id) {",
              "  pm.environment.set('taskId', response.data.id);",
              "}",
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Design system setup\",\n  \"projectId\": \"project-fintech-redesign\",\n  \"projectName\": \"Fintech Mobile App Redesign\",\n  \"workstreamId\": \"ws-discovery\",\n  \"workstreamName\": \"Initial discovery & alignment\",\n  \"description\": \"Establish the token and spacing system.\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"tag\": \"design\",\n  \"startDate\": \"2026-03-25T00:00:00.000Z\",\n  \"dueDate\": \"2026-03-27T00:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Create a new project-oriented task."
      }
    },
    {
      "name": "Get My Tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/my-tasks?page=1&limit=10&status=todo,in-progress&projectId=project-fintech-redesign&tags=design&view=board&groupBy=status&sortBy=startDate&sortOrder=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "my-tasks"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "status",
              "value": "todo,in-progress"
            },
            {
              "key": "projectId",
              "value": "project-fintech-redesign"
            },
            {
              "key": "tags",
              "value": "design"
            },
            {
              "key": "view",
              "value": "board"
            },
            {
              "key": "groupBy",
              "value": "status"
            },
            {
              "key": "sortBy",
              "value": "startDate"
            },
            {
              "key": "sortOrder",
              "value": "asc"
            }
          ]
        },
        "description": "Fetch the authenticated user's tasks with pagination and top-level meta.filterCounts."
      }
    },
    {
      "name": "List Tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks?page=1&limit=10&priority=high&sortBy=createdAt&sortOrder=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "priority",
              "value": "high"
            },
            {
              "key": "sortBy",
              "value": "createdAt"
            },
            {
              "key": "sortOrder",
              "value": "desc"
            }
          ]
        },
        "description": "List tasks through the general authenticated listing endpoint."
      }
    },
    {
      "name": "Get Task by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "description": "Fetch a single task by id."
      }
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in-progress\",\n  \"name\": \"Updated design system setup\",\n  \"tag\": \"frontend\",\n  \"startDate\": \"2026-03-26T00:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "description": "Update task fields such as status, name, tag, or dates."
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "description": "Delete a task."
      }
    },
    {
      "name": "Search Tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks?search=design&page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ],
          "query": [
            {
              "key": "search",
              "value": "design"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Search tasks by name, description, project name, or workstream name."
      }
    },
    {
      "name": "Filter by Start Date",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/my-tasks?startDateFrom=2026-03-01&startDateTo=2026-03-31&page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "my-tasks"
          ],
          "query": [
            {
              "key": "startDateFrom",
              "value": "2026-03-01"
            },
            {
              "key": "startDateTo",
              "value": "2026-03-31"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Filter tasks by scheduled start date range."
      }
    }
  ]
}
