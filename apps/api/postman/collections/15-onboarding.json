{
  "info": {
    "name": "15 - Onboarding",
    "description": "Onboarding state and session management for new users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get My Onboarding State",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/onboarding/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "onboarding",
            "me"
          ]
        }
      }
    },
    {
      "name": "Start/Resume Onboarding",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/onboarding/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "onboarding",
            "start"
          ]
        }
      }
    },
    {
      "name": "Update Profile Step",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": {\n    \"fullName\": \"John Doe\",\n    \"role\": \"Project Manager\"\n  },\n  \"nextStep\": \"workspace\",\n  \"markComplete\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/onboarding/steps/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "onboarding",
            "steps",
            "profile"
          ]
        }
      }
    },
    {
      "name": "Update Workspace Step",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": {\n    \"workspaceName\": \"My Awesome Team\",\n    \"teamSize\": \"5-10\"\n  },\n  \"nextStep\": \"preferences\",\n  \"markComplete\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/onboarding/steps/workspace",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "onboarding",
            "steps",
            "workspace"
          ]
        }
      }
    },
    {
      "name": "Complete Onboarding",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/onboarding/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "onboarding",
            "complete"
          ]
        }
      }
    }
  ]
}
