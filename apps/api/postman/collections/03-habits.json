{
  "info": {
    "name": "03 - Habits",
    "description": "Habit tracking endpoints - Full CRUD with streak tracking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Habit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.data && response.data.id) {",
              "  pm.environment.set('habitId', response.data.id);",
              "}",
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Morning Exercise\",\n  \"description\": \"30 minutes of cardio or strength training\",\n  \"frequency\": \"daily\",\n  \"targetDays\": [0, 1, 2, 3, 4, 5, 6],\n  \"reminderTime\": \"07:00\",\n  \"color\": \"#FF5733\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/habits",
          "host": ["{{baseUrl}}"],
          "path": ["habits"]
        },
        "description": "Create a new habit"
      }
    },
    {
      "name": "List Habits",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habits?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["habits"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "List all habits for the user"
      }
    },
    {
      "name": "Get Habit by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habits/{{habitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["habits", "{{habitId}}"]
        },
        "description": "Get a specific habit with streak info"
      }
    },
    {
      "name": "Update Habit",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Habit Name\",\n  \"reminderTime\": \"08:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/habits/{{habitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["habits", "{{habitId}}"]
        },
        "description": "Update a habit"
      }
    },
    {
      "name": "Delete Habit",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habits/{{habitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["habits", "{{habitId}}"]
        },
        "description": "Delete a habit"
      }
    }
  ]
}
