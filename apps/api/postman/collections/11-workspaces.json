{
  "info": {
    "name": "11 - Workspaces",
    "description": "Workspace management - Create workspaces, manage memberships, and switch contexts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Workspace",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.data && response.data._id) {",
              "  pm.environment.set('workspaceId', response.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Personal Life Dashboard\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/workspaces",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces"]
        }
      }
    },
    {
      "name": "List Workspaces",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/workspaces",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces"]
        }
      }
    },
    {
      "name": "Get Context Workspace",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces", "{{workspaceId}}"]
        }
      }
    },
    {
      "name": "Update Workspace",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Family Dashboard\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces", "{{workspaceId}}"]
        }
      }
    },
    {
      "name": "Invite Member",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"role\": \"MEMBER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/invitations",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces", "{{workspaceId}}", "invitations"]
        }
      }
    },
    {
      "name": "Remove Member",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/members/someUserId123",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces", "{{workspaceId}}", "members", "someUserId123"]
        }
      }
    },
    {
      "name": "Delete Workspace",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["workspaces", "{{workspaceId}}"]
        }
      }
    }
  ]
}
