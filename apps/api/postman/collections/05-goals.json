{
  "info": {
    "name": "05 - Goals",
    "description": "Goal management - Set goals, link tasks/habits, track progress",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Goal",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.data && response.data.id) {",
              "  pm.environment.set('goalId', response.data.id);",
              "}",
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn TypeScript\",\n  \"description\": \"Complete TypeScript mastery by end of Q2\",\n  \"targetValue\": 100,\n  \"currentValue\": 25,\n  \"unit\": \"hours\",\n  \"dueDate\": \"2024-06-30T23:59:59.000Z\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/goals",
          "host": ["{{baseUrl}}"],
          "path": ["goals"]
        },
        "description": "Create a new goal"
      }
    },
    {
      "name": "List Goals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/goals?page=1&limit=20&status=active",
          "host": ["{{baseUrl}}"],
          "path": ["goals"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "status",
              "value": "active"
            }
          ]
        },
        "description": "List goals with optional status filter"
      }
    },
    {
      "name": "Get Goal by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}",
          "host": ["{{baseUrl}}"],
          "path": ["goals", "{{goalId}}"]
        },
        "description": "Get goal with linked tasks and habits"
      }
    },
    {
      "name": "Update Goal",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentValue\": 50,\n  \"status\": \"in_progress\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}",
          "host": ["{{baseUrl}}"],
          "path": ["goals", "{{goalId}}"]
        },
        "description": "Update goal progress"
      }
    },
    {
      "name": "Delete Goal",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}",
          "host": ["{{baseUrl}}"],
          "path": ["goals", "{{goalId}}"]
        },
        "description": "Delete a goal"
      }
    },
    {
      "name": "Link Tasks to Goal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"taskIds\": [\"{{taskId}}\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["goals", "{{goalId}}", "tasks"]
        },
        "description": "Link tasks to a goal"
      }
    },
    {
      "name": "Link Habits to Goal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"habitIds\": [\"{{habitId}}\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}/habits",
          "host": ["{{baseUrl}}"],
          "path": ["goals", "{{goalId}}", "habits"]
        },
        "description": "Link habits to a goal"
      }
    },
    {
      "name": "Log Progress",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 5,\n  \"note\": \"Completed 5 hours of study today\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}/progress",
          "host": ["{{baseUrl}}"],
          "path": ["goals", "{{goalId}}", "progress"]
        },
        "description": "Log progress toward a goal"
      }
    }
  ]
}
