{
  "info": {
    "name": "04 - Habit Logs",
    "description": "Habit completion logging - Track daily habit completion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Habit Log",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.data && response.data.id) {",
              "  pm.environment.set('habitLogId', response.data.id);",
              "}",
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"habitId\": \"{{habitId}}\",\n  \"loggedDate\": \"2024-01-15\",\n  \"completed\": true,\n  \"notes\": \"Felt great today!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/habit-logs",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs"]
        },
        "description": "Log a habit completion for a specific date"
      }
    },
    {
      "name": "List All Habit Logs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habit-logs?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "List all habit logs for the user"
      }
    },
    {
      "name": "List Logs by Habit",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habit-logs/habit/{{habitId}}?page=1&limit=30",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs", "habit", "{{habitId}}"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "30"
            }
          ]
        },
        "description": "List all logs for a specific habit"
      }
    },
    {
      "name": "Get Habit Log by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habit-logs/{{habitLogId}}",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs", "{{habitLogId}}"]
        },
        "description": "Get a specific habit log"
      }
    },
    {
      "name": "Update Habit Log",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true,\n  \"notes\": \"Updated notes for the log\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/habit-logs/{{habitLogId}}",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs", "{{habitLogId}}"]
        },
        "description": "Update a habit log"
      }
    },
    {
      "name": "Delete Habit Log",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habit-logs/{{habitLogId}}",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs", "{{habitLogId}}"]
        },
        "description": "Delete a habit log"
      }
    },
    {
      "name": "Filter by Date Range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habit-logs?dateFrom=2024-01-01&dateTo=2024-01-31&page=1&limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["habit-logs"],
          "query": [
            {
              "key": "dateFrom",
              "value": "2024-01-01"
            },
            {
              "key": "dateTo",
              "value": "2024-01-31"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        },
        "description": "Filter habit logs by date range"
      }
    }
  ]
}
