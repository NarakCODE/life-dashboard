{
  "info": {
    "name": "13 - Chat",
    "description": "Channels, messages, and unread status management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Channels",
      "item": [
        {
          "name": "Create Channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"public\",\n  \"name\": \"general-discussion\",\n  \"description\": \"Project-wide general talk\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "channels"
              ]
            }
          }
        },
        {
          "name": "Get My Channels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "channels"
              ]
            }
          }
        },
        {
          "name": "Get Channel by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/channels/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "channels",
                "{{channelId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelId\": \"{{channelId}}\",\n  \"content\": \"Hello team! How are we doing today?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Get Channel Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/channels/{{channelId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "channels",
                "{{channelId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Update Message",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello team! (edited)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/messages/{{messageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "messages",
                "{{messageId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/messages/{{messageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "messages",
                "{{messageId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Unread / Read Status",
      "item": [
        {
          "name": "Mark Channel Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageId\": \"{{lastSeenMessageId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/channels/{{channelId}}/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "channels",
                "{{channelId}}",
                "read"
              ]
            }
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/read-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "read-all"
              ]
            }
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/unread-count",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "unread-count"
              ]
            }
          }
        },
        {
          "name": "Get Unread Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "x-workspace-id",
                "value": "{{workspaceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/unread-summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "unread-summary"
              ]
            }
          }
        }
      ]
    }
  ]
}
