{
  "info": {
    "name": "12 - Projects",
    "description": "Workspace-scoped project endpoints. Use this collection to seed `projectId` and `workstreamId` for the tasks collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "if (response.data?.id) {",
              "  pm.environment.set('projectId', response.data.id);",
              "}",
              "if (response.data?.workstreams?.[0]?.id) {",
              "  pm.environment.set('workstreamId', response.data.workstreams[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fintech Mobile App Redesign\",\n  \"status\": \"active\",\n  \"priority\": \"medium\",\n  \"typeLabel\": \"MVP\",\n  \"durationLabel\": \"2 weeks\",\n  \"workstreams\": [\n    {\n      \"name\": \"Initial discovery & alignment\",\n      \"order\": 0\n    },\n    {\n      \"name\": \"Design system refresh\",\n      \"order\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects"
          ]
        },
        "description": "Create a project and persist the first workstream id for downstream task examples."
      }
    },
    {
      "name": "List Projects",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const project = Array.isArray(response.data) ? response.data[0] : null;",
              "if (project?.id) {",
              "  pm.environment.set('projectId', project.id);",
              "}",
              "if (project?.workstreams?.[0]?.id) {",
              "  pm.environment.set('workstreamId', project.workstreams[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects"
          ]
        }
      }
    },
    {
      "name": "Get Project by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}"
          ]
        }
      }
    },
    {
      "name": "Update Project",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fintech Mobile App Redesign Phase 2\",\n  \"priority\": \"high\",\n  \"durationLabel\": \"3 weeks\",\n  \"workstreams\": [\n    {\n      \"name\": \"Initial discovery & alignment\",\n      \"order\": 0\n    },\n    {\n      \"name\": \"Prototype validation\",\n      \"order\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Project",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-workspace-id",
            "value": "{{workspaceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}"
          ]
        }
      }
    }
  ]
}
